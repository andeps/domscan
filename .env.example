# Copy this file to .env and adjust values for the local environment.

# Server
DOMAIN_TOOL_ADDR=:8080
DOMAIN_GIN_MODE=release
DOMAIN_HTTP_READ_HEADER_TIMEOUT=5s
DOMAIN_HTTP_IDLE_TIMEOUT=60s
DOMAIN_HTTP_SHUTDOWN_TIMEOUT=5s
DOMAIN_HTTP_REQUEST_TIMEOUT=15m

# RDAP availability checks
DOMAIN_RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
DOMAIN_RDAP_FALLBACK_URLS=https://rdap-bootstrap.arin.net/bootstrap/domain/,https://rdap.org/domain/
DOMAIN_RDAP_PROVIDER_CONCURRENCY=3
DOMAIN_RDAP_TIMEOUT=12s

# Redis cache. Supports redis:// and rediss:// URLs.
# Password only: redis://:password@192.168.2.100:6379/0
# ACL user:      redis://username:password@192.168.2.100:6379/0
DOMAIN_REDIS_ENABLED=false
DOMAIN_REDIS_URL=redis://localhost:6379/0
DOMAIN_REDIS_KEY_PREFIX=domscan:availability:
DOMAIN_REDIS_DIAL_TIMEOUT=2s
DOMAIN_CACHE_TTL=24h
DOMAIN_CACHE_UNKNOWN_TTL=5m

# Email notification (disabled by default)
DOMAIN_EMAIL_ENABLED=false
DOMAIN_SMTP_HOST=smtp.example.com
DOMAIN_SMTP_PORT=587
DOMAIN_SMTP_USERNAME=
DOMAIN_SMTP_PASSWORD=
DOMAIN_SMTP_FROM=
DOMAIN_EMAIL_TO=
DOMAIN_EMAIL_TIMEOUT=15s
DOMAIN_EMAIL_BATCH_SIZE=10

# PostgreSQL user accounts
DOMAIN_DATABASE_ENABLED=true
DOMAIN_DATABASE_URL=postgres://domscan:domscan@localhost:5432/domscan?sslmode=disable
DOMAIN_JWT_SECRET=change-this-secret-in-production-please-32chars
